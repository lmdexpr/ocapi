# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Derive ocapi endpoint declarations from types"
description: """
[@@deriving provide] reads a request record from an HTTP request, [@@deriving responses] sends
a result variant, [@@deriving ocapi] makes a codec of derived JSON functions; doc comments
become descriptions. The output is ordinary ocapi combinators."""
maintainer: ["Yuki Tajiri <lmdexpr@gmail.com>"]
authors: ["Yuki Tajiri"]
license: "MIT"
homepage: "https://github.com/lmdexpr/ocapi"
bug-reports: "https://github.com/lmdexpr/ocapi/issues"
depends: [
  "ocaml" {>= "5.3.0"}
  "dune" {>= "3.23"}
  "ocapi" {= version}
  "ppxlib" {>= "0.36.0"}
  "odoc-parser" {>= "3.0.0"}
  "ocapi-openapi" {with-test & = version}
  "ocapi-jsonschema" {with-test & = version}
  "ppx_deriving_jsonschema" {with-test}
  "ppx_yojson_conv" {with-test}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lmdexpr/ocapi.git"
x-maintenance-intent: ["(latest)"]
