# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Cohttp-eio adapters for ocapi"
description: """
Serves ocapi routes with a cohttp-eio server and handles the ocapi client effect with a
cohttp-eio client."""
maintainer: ["Yuki Tajiri <lmdexpr@gmail.com>"]
authors: ["Yuki Tajiri"]
license: "MIT"
homepage: "https://github.com/lmdexpr/ocapi"
bug-reports: "https://github.com/lmdexpr/ocapi/issues"
depends: [
  "ocaml" {>= "5.3.0"}
  "dune" {>= "3.23"}
  "ocapi" {= version}
  "eio"
  "cohttp-eio"
  "http"
  "uri"
  "yojson"
  "eio_main" {with-test}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lmdexpr/ocapi.git"
x-maintenance-intent: ["(latest)"]
