opam-version: "2.0"
synopsis: "OpenAPI 3.1 documents of ocapi endpoints"
description: """
Derives the OpenAPI 3.1 document of ocapi endpoint values. Only endpoints whose every part
has a schema are documented, which the types check."""
maintainer: ["Yuki Tajiri <lmdexpr@gmail.com>"]
authors: ["Yuki Tajiri"]
license: "MIT"
