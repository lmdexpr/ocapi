# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Declare an HTTP endpoint once, derive the server, the client and the OpenAPI document"
description: """
An HTTP endpoint as a value: method, path, parameters, request body and responses.
Server routing, client requests and the OpenAPI document are derived from it.
Transports are effect handlers; this package depends on yojson only."""
maintainer: ["Yuki Tajiri <lmdexpr@gmail.com>"]
authors: ["Yuki Tajiri"]
license: "MIT"
homepage: "https://github.com/lmdexpr/ocapi"
bug-reports: "https://github.com/lmdexpr/ocapi/issues"
depends: [
  "ocaml" {>= "5.3.0"}
  "dune" {>= "3.23"}
  "yojson"
  "alcotest" {with-test}
  "ocamlformat" {with-dev-setup}
  "ocaml-lsp-server" {with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lmdexpr/ocapi.git"
x-maintenance-intent: ["(latest)"]
