# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Use ppx_deriving_jsonschema schemas in ocapi endpoints"
description:
  "Codecs and body providers taking the schemas ppx_deriving_jsonschema derives."
maintainer: ["Yuki Tajiri <lmdexpr@gmail.com>"]
authors: ["Yuki Tajiri"]
license: "MIT"
homepage: "https://github.com/lmdexpr/ocapi"
bug-reports: "https://github.com/lmdexpr/ocapi/issues"
depends: [
  "ocaml" {>= "5.3.0"}
  "dune" {>= "3.23"}
  "ocapi" {= version}
  "ppx_deriving_jsonschema" {>= "0.0.7"}
  "yojson"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lmdexpr/ocapi.git"
x-maintenance-intent: ["(latest)"]
