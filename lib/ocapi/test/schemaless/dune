; An endpoint with a part without a schema does not compile into the document.

(rule
 (deps
  (glob_files ../../.ocapi.objs/byte/*.cmi))
 (action
  (with-outputs-to
   schemaless.actual
   (with-accepted-exit-codes
    2
    (run
     %{ocamlc}
     -I
     ../../.ocapi.objs/byte
     -c
     -o
     schemaless.cmo
     -impl
     %{dep:schemaless.ml.in})))))

(rule
 (alias runtest)
 (package ocapi)
 (action
  (diff schemaless.expected schemaless.actual)))
