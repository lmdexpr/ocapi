; What the derivers refuse, as the driver reports it: at compile time, not when the endpoint
; is made. Colors are off, so the output does not depend on the terminal.

(rule
 (with-outputs-to
  authorization.actual
  (with-accepted-exit-codes
   1
   (setenv
    OCAML_COLOR
    never
    (run %{exe:../pp.exe} -impl %{dep:authorization.ml.in})))))

(rule
 (alias runtest)
 (package ocapi-ppx)
 (action
  (diff authorization.expected authorization.actual)))

